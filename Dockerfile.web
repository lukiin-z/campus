# Imagem do front do Campus (Vite + React, servido por nginx).
#
# Construída da RAIZ do repositório, não de `app/`:
#
#     docker build -f Dockerfile.web -t campus-web .
#
# `VITE_API_URL` tem padrão `/api` e raramente precisa ser passado; a razão
# está junto do `ARG` mais abaixo.
#
# Contexto na raiz porque `app` resolve `@campus/shared` pela FONTE
# (`packages/shared/src`, ver o alias em app/vite.config.ts) e o lockfile do
# monorepo é único, na raiz.
#
# ---------------------------------------------------------------------------
# `VITE_*` é resolvido em BUILD, e isso muda o desenho da imagem
# ---------------------------------------------------------------------------
#
# O Vite substitui `import.meta.env.VITE_X` pelo valor literal durante o build:
# o resultado é JavaScript estático, e nada em tempo de execução consegue
# alterá-lo. Passar `-e VITE_API_URL=...` no `docker run` NÃO tem efeito — o
# valor já está dentro do `.js` servido. É o erro clássico com Vite em
# container, e o motivo de estes valores entrarem como `ARG`.
#
# Consequência prática: apontar o front para outra API exige RECONSTRUIR a
# imagem. Quem precisa trocar de API sem rebuild deve usar `VITE_API_URL=/api`
# (mesma origem) e deixar o proxy do nginx decidir o destino — esse sim é
# ajustável em runtime, por `API_UPSTREAM`.

# ---------------------------------------------------------------------------
# build — Vite
# ---------------------------------------------------------------------------
# Mesma base da imagem da API (Dockerfile.api), de propósito: as camadas de
# sistema e de `npm ci` são compartilhadas quando as duas imagens são
# construídas na mesma máquina, que é o caso do `docker compose up`.
FROM node:22.17.0-slim AS build

WORKDIR /app

# Manifestos antes do código, para a camada de instalação sobreviver a edições
# de `.tsx`. Os quatro são obrigatórios: `npm ci` valida o lockfile contra toda
# a árvore de workspaces e recusa se algum manifesto declarado faltar —
# inclusive `api`, que esta imagem não usa.
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY app/package.json app/
COPY api/package.json api/

# `--ignore-scripts`: nenhuma dependência do front precisa de script de
# instalação, e desligá-los remove a execução de código arbitrário de terceiro
# durante o build. O binário nativo de que o Vite depende (esbuild, rollup)
# entra por dependência opcional resolvida pela plataforma, não por script.
RUN npm ci --ignore-scripts

COPY packages/shared packages/shared
COPY app app

# Os dois valores que o front precisa saber antes de existir.
#
#   VITE_API_URL     — base das chamadas. O padrão é `/api`: mesma origem,
#                      atravessando o proxy do nginx desta própria imagem.
#
#                      O padrão era `http://localhost:3000/api`, e ele funciona
#                      em exatamente uma máquina — a de quem constrói. O
#                      JavaScript roda no navegador de quem ABRE a página, e
#                      `localhost:3000` ali é a porta 3000 DELE: numa VM, num
#                      servidor ou na nuvem, o front tentava falar com uma API
#                      que não existe. Com `/api` funciona nos dois casos, e
#                      sem CORS.
#   VITE_DATA_SOURCE — qual implementação da camada de dados sobe (ADR-0003):
#                      `api` fala com a API real, `mock` sobe o MSW. A imagem
#                      existe para servir a API real, então o padrão é `api`.
ARG VITE_API_URL=/api
ARG VITE_DATA_SOURCE=api

# `ENV` a partir do `ARG` porque o Vite lê do ambiente do processo, não dos
# argumentos de build.
ENV VITE_API_URL=$VITE_API_URL \
    VITE_DATA_SOURCE=$VITE_DATA_SOURCE

# Sem `GITHUB_PAGES=true`: a base fica `/`, que é o certo para servir na raiz de
# um domínio. Com a variável, o Vite usaria a base `/campus/` do GitHub Pages e
# todos os assets desta imagem responderiam 404.
RUN npm run build -w campus-app

# ---------------------------------------------------------------------------
# runtime — nginx
# ---------------------------------------------------------------------------
FROM nginx:1.27-alpine AS runtime

# Destino do proxy de `/api/`. Ajustável em runtime (`-e API_UPSTREAM=...`)
# porque, ao contrário das `VITE_*`, isto é lido pelo nginx a cada subida.
ENV API_UPSTREAM=http://api:3000

# Restringe a substituição do template ao que é nosso. Sem o filtro, o script
# do entrypoint monta a lista a partir de TODO o ambiente do container e um
# `$uri` ou `$host` do nginx poderia ser apagado por uma variável homônima.
ENV NGINX_ENVSUBST_FILTER=API_UPSTREAM

# `templates/` e não `conf.d/`: o entrypoint da imagem oficial roda `envsubst`
# em `/etc/nginx/templates/*.template` e escreve o resultado em
# `/etc/nginx/conf.d/` antes de subir o nginx. É o que permite `API_UPSTREAM`
# valer em runtime.
COPY <<'CONF' /etc/nginx/templates/campus.conf.template
# `map` no nível do http (este arquivo é incluído dentro do bloco `http` do
# nginx.conf da imagem), e não `add_header` por `location`, por uma armadilha
# real do nginx: `add_header` declarado dentro de um `location` DESCARTA todos
# os `add_header` herdados do `server`. Uma regra de cache por location
# apagaria os cabeçalhos de segurança justamente nas rotas que ela cobre.
# Derivando o Cache-Control de uma variável, os `add_header` ficam todos em um
# lugar só e nada é herdado pela metade.
map $uri $campus_cache_control {
    # Nome com hash é imutável: o nome muda quando o conteúdo muda.
    ~^/assets/  "public, max-age=31536000, immutable";

    # Todo o resto tem nome fixo — index.html, manifest, ícones, o worker do
    # MSW. Cacheá-los deixa a versão antiga sobreviver ao deploy: um
    # index.html velho aponta para assets com hash que não existem mais, e o
    # resultado é tela branca.
    default     "no-cache, must-revalidate";
}

server {
    listen       80;
    listen  [::]:80;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    add_header Cache-Control          $campus_cache_control always;

    # Cabeçalhos de segurança que não dependem de aplicação. CSP fica de fora
    # de propósito: escrita às cegas ela quebra o app e o remédio viraria
    # `unsafe-inline`, que não protege de nada.
    add_header X-Content-Type-Options "nosniff"     always;
    add_header X-Frame-Options        "SAMEORIGIN"  always;
    add_header Referrer-Policy        "same-origin" always;

    # O que faz uma SPA funcionar em URL profunda.
    #
    # Sem isto, `/eventos/evt-001` procura um arquivo com esse nome, não acha e
    # responde 404: a navegação por dentro do app funciona, mas recarregar a
    # página ou abrir um link compartilhado quebra. O React Router precisa que
    # o servidor devolva o index.html e deixe o roteamento para o cliente — é o
    # mesmo papel do `404.html` no GitHub Pages.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Asset que não existe deve dar 404, não index.html: cair na SPA aqui
    # devolveria HTML com status 200 no lugar de um `.js`, e o erro apareceria
    # como "Unexpected token '<'" no console — muito longe da causa.
    location /assets/ {
        try_files $uri =404;
    }

    # `.webmanifest` não está no mime.types do nginx 1.27 (conferido no
    # arquivo da imagem): o manifest sairia como application/octet-stream e o
    # Chrome o descartaria em silêncio — o app deixa de ser instalável, sem
    # nenhum erro no console.
    #
    # A correção é `default_type` num location, e NÃO um bloco `types` no
    # server. Isto custou uma rodada de build: `types` não acrescenta ao mapa
    # herdado, ele SUBSTITUI o mapa inteiro. Com um `types` de uma linha aqui,
    # o manifest saía certo e todo o resto — inclusive o index.html — passou a
    # sair como application/octet-stream. Medido:
    #
    #   GET /  →  200 application/octet-stream    (com o bloco `types`)
    #   GET /  →  200 text/html                   (com este `location`)
    location ~* \.webmanifest$ {
        default_type application/manifest+json;
    }

    # Proxy de mesma origem para a API — o caminho PADRÃO desde o CP6, quando
    # `VITE_API_URL` passou a ser `/api`. Todo o tráfego de dados do front
    # atravessa este bloco.
    #
    # O destino passa por VARIÁVEL, não por literal: com `proxy_pass
    # http://api:3000` o nginx resolve o nome na LEITURA da configuração e se
    # recusa a subir enquanto o container da API não existir — o front morreria
    # junto com a API. Com variável, a resolução é por requisição, e a API
    # ausente devolve 502 em `/api/` em vez de derrubar o servidor.
    location /api/ {
        # DNS embutido do Docker. Só existe em rede definida pelo usuário, que
        # é a que o compose cria; fora dela, `/api/` responde 502 e o resto do
        # site segue de pé.
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $campus_api "${API_UPSTREAM}";

        proxy_pass       $campus_api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;

        # Resposta de API não se cacheia, e o `add_header` local aqui é
        # deliberado: os cabeçalhos de segurança desta rota são os que a
        # própria API manda (helmet), não os do nginx.
        add_header Cache-Control "no-store" always;
    }

    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_types        text/plain text/css application/javascript application/json
                      application/manifest+json image/svg+xml;
}
CONF

# `default.conf` da imagem base removido: ele também escuta na 80 e o nginx
# usaria o primeiro `server` como padrão — o site do "Welcome to nginx".
RUN rm -f /etc/nginx/conf.d/default.conf

COPY --from=build /app/app/dist /usr/share/nginx/html

# O healthcheck bate no index.html pelo próprio nginx: `wget` existe no
# BusyBox da imagem alpine, sem instalar nada.
HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1

EXPOSE 80
