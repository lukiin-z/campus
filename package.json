{
  "name": "campus",
  "private": true,
  "version": "0.1.0",
  "description": "Campus - app de eventos universitarios (FIAP, Engenharia de Software)",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "app",
    "api"
  ],
  "scripts": {
    "dev": "npm run dev -w campus-app",
    "dev:api": "npm run start:dev -w campus-api",
    "build": "npm run build -w @campus/shared && npm run build -w campus-app && npm run build -w campus-api",
    "lint": "npm run lint -w campus-app && npm run lint -w campus-api",
    "format": "prettier --write \"{app,api,packages}/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{app,api,packages}/**/*.{ts,tsx,css}\"",
    "test": "npm run test -w campus-app && npm run test -w campus-api",
    "test:e2e": "npm run test:e2e -w campus-app",
    "diagrams": "node scripts/render-diagrams.mjs",
    "validate:docs": "node scripts/validate-docs.mjs",
    "check:scale": "node scripts/check-tailwind-scale.mjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "check:contrato": "node scripts/check-contrato.mjs",
    "check:rotas": "node scripts/check-rotas.mjs",
    "test:dominio": "vitest run --root packages/shared",
    "test:coverage": "npm run test:coverage -w @campus/shared && npm run test:coverage -w campus-app"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^8.57.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
