# Variáveis de ambiente da API do Campus — CP6.
#
# NENHUM VALOR REAL MORA AQUI. Este arquivo é a lista do que a API exige, com a
# descrição de cada nome. Copie para `.env` (que está no .gitignore) e preencha
# localmente.
#
# A validação é feita no boot, em `src/config/ambiente.ts`: variável obrigatória
# ausente ou fora de faixa derruba a API antes de ela aceitar a primeira
# requisição. Não existe valor padrão para segredo — uma API que sobe com
# `JWT_SECRET=dev` em produção assina token que qualquer pessoa forja (RNF-020).

# ---------------------------------------------------------------------------
# Obrigatórias — sem uma destas a API não sobe
# ---------------------------------------------------------------------------

# Conexão do PostgreSQL, no formato do Prisma:
# postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL=

# Segredo do JWT de acesso. Mínimo de 32 caracteres.
# Gere um valor aleatório: `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=

# Segredo do HMAC do webhook de pagamento (cabeçalho `X-Assinatura`). Mínimo de
# 16 caracteres. É o que distingue notificação do gateway de requisição
# forjada — RN-014 diz que a confirmação vem SOMENTE do gateway, e sem
# assinatura essa frase não tem como ser verdadeira.
WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Opcionais — têm padrão seguro para desenvolvimento
# ---------------------------------------------------------------------------

# development | test | production. Em `production` a rota de simulação do
# gateway (`POST /pagamentos/:id/simular`) responde 404 (ADR-0006).
NODE_ENV=development

# Porta HTTP. Padrão: 3000.
PORT=3000

# Validade do token de acesso, em minutos. Padrão: 15 (RNF-020).
JWT_ACCESS_TTL_MINUTES=15

# Validade do refresh, em dias. Padrão: 30. O refresh é revogável: o que fica
# na tabela `sessao` é o HASH, nunca o token.
JWT_REFRESH_TTL_DAYS=30

# Origens aceitas no CORS, separadas por vírgula. Padrão: o dev server do Vite.
CORS_ORIGINS=http://localhost:5173

# Teto de requisições por janela nas rotas de credencial (RNF-021), e o tamanho
# da janela em segundos. Padrões: 10 e 60.
RATE_LIMIT_TENTATIVAS=10
RATE_LIMIT_JANELA_SEGUNDOS=60

# Libera POST /pagamentos/:id/simular, o gatilho do gateway fake (ADR-0006).
# Padrao: false. A stack de demonstracao do docker-compose o define como true,
# porque roda NODE_ENV=production de proposito e sem a flag o fluxo de pagamento
# ficaria indemonstravel. Em producao de verdade, deixe ausente.
PERMITIR_SIMULACAO_PAGAMENTO=
