# Variáveis do app (Vite). Copie para `.env.local` e ajuste.
#
# Nenhum valor real aqui: `.env.example` é o único arquivo de ambiente versionado
# (ver .gitignore) e ele descreve as chaves, não as configura. Nenhuma delas é
# segredo — tudo que o Vite expõe com o prefixo `VITE_` vai para o bundle e é
# legível por qualquer visitante. Chave de API, senha e segredo de assinatura
# NÃO entram aqui nem em nenhum outro `.env` do app: eles ficam no servidor.
#
# O app funciona sem nenhum arquivo `.env`. Os padrões estão no código, com a
# justificativa: `src/services/index.ts` (fonte de dados) e
# `src/services/api/index.ts` (endereço e tempo limite).

# De onde vêm os dados.
#   mock  → mock do CP5 interceptado pelo MSW, sem backend (PADRÃO)
#   api   → API real do CP6, contrato em api/openapi.yaml
# O padrão é `mock` porque a demonstração publicada no GitHub Pages serve
# arquivo estático e não tem servidor para chamar.
VITE_DATA_SOURCE=

# Endereço da API, já incluindo o prefixo `/api`.
# Só tem efeito com VITE_DATA_SOURCE=api.
# Padrão: http://localhost:3000/api — o `servers[0]` do openapi.yaml, que é o
# que `npm run dev:api` sobe.
VITE_API_URL=

# Tempo limite de cada requisição, em milissegundos. Padrão: 10000.
# Abaixar ajuda a ver a mensagem de indisponibilidade na demonstração; subir só
# faz sentido em rede muito ruim.
VITE_API_TIMEOUT_MS=
